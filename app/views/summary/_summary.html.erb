<div class="space-y-3">

  <% balances.each do |user_id, amount| %>
    <% user = User.find(user_id) %>

    <div class="p-3 border rounded-xl flex justify-between">

      <div>
        <div class="font-medium"><%= user.name %></div>

        <div class="text-sm text-gray-500">
          <% if amount > 0 %>
            owes you
          <% elsif amount < 0 %>
            you owe
          <% else %>
            settled
          <% end %>
        </div>
      </div>

      <div class="<%= amount >= 0 ? 'text-green-600' : 'text-red-600' %> font-bold">
        <% if amount > 0 %>
          +$<%= amount.round(2) %>
        <% elsif amount < 0 %>
          -$<%= amount.abs.round(2) %>
        <% else %>
          $0
        <% end %>
      </div>

    </div>

  <% end %>

</div>