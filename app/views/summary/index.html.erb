<div class="max-w-md mx-auto px-4 py-6 pb-24">

  <%= render "shared/mobile_header",
      back_path: root_path %>

  <!-- HEADER -->

  <h1 class="text-4xl font-bold mb-2">
    Hi <%= @current_user.name %> 👋
  </h1>

  <p class="text-gray-500 mb-8">
    Here's your current balance
  </p>

  <!-- NET BALANCE -->

  <div class="
    rounded-3xl p-6 text-white mb-10
    <%= @net_balance >= 0 ?
        'bg-green-500' :
        'bg-red-500' %>
  ">

    <div class="text-lg mb-2">
      Net balance
    </div>

    <div class="text-5xl font-bold mb-3">
      $<%= @net_balance.abs.round(2) %>
    </div>

    <div class="text-xl">

      <% if @net_balance >= 0 %>
        People owe you
      <% else %>
        You owe people
      <% end %>

    </div>

  </div>

  <!-- ACTIONS -->

  <div class="grid grid-cols-2 gap-4 mt-10">

    <%= link_to new_expense_path,
        class: "
          bg-black text-white
          py-4 rounded-2xl
          text-center text-xl font-medium
        " do %>

      ➕ Add Expense

    <% end %>

    <%= link_to expenses_path,
        class: "
          border border-black
          py-4 rounded-2xl
          text-center text-xl font-medium
        " do %>

      📜 History

    <% end %>

  </div>


  <!-- DETAILS -->

  <h2 class="text-2xl font-bold mb-4">
    Details
  </h2>

  <% if @debts.empty? %>

    <div class="border rounded-2xl p-6 bg-white text-center text-gray-500">
      🎉 All settled up
    </div>

  <% else %>

    <div class="space-y-3">

      <% @debts.each do |debt| %>

        <% is_current_user_creditor =
            debt[:creditor].id ==
            @current_user.id %>

        <div class="border rounded-2xl p-4 bg-white">

          <div class="flex justify-between items-start">

            <!-- LEFT -->

            <div>

              <!-- NAME -->

              <div class="font-semibold text-2xl">

                <% if is_current_user_creditor %>

                  <%= debt[:debtor].name %>

                <% else %>

                  <%= debt[:creditor].name %>

                <% end %>

              </div>

              <!-- STATUS -->

              <div class="text-gray-500 text-sm mt-1">

                <% if is_current_user_creditor %>

                  owes you

                <% else %>

                  you owe

                <% end %>

              </div>

              <!-- AMOUNT -->

              <div class="
                text-4xl font-bold mt-4
                <%= is_current_user_creditor ?
                    'text-green-600' :
                    'text-red-600' %>
              ">

                $<%= debt[:amount].round(2) %>

              </div>

            </div>

            <!-- BUTTON -->

            <% if is_current_user_creditor %>

              <%= button_to "Mark paid",
                  settlements_path(
                    user_id: debt[:debtor].id,
                    paid_to_id: debt[:creditor].id
                  ),
                  method: :post,
                  class: "
                    bg-black text-white
                    px-4 py-2
                    rounded-xl
                  " %>

            <% end %>

          </div>

        </div>

      <% end %>

    </div>

  <% end %>

  
</div>