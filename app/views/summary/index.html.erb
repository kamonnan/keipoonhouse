<div class="max-w-xl mx-auto p-6">

  <h1 class="text-3xl font-bold mb-2">
    Hi <%= @current_user.name %> 👋
  </h1>

  <p class="text-gray-500 mb-6">
    Here’s your current balance
  </p>

  <!-- NET BALANCE CARD -->
  <% net = @net_balance || 0 %>

  <div class="p-4 rounded-xl mb-6 text-white
    <%= net >= 0 ? 'bg-green-500' : 'bg-red-500' %>">

    <div class="text-sm opacity-80">
      Net balance
    </div>

    <div class="text-2xl font-bold">
      <% if net >= 0 %>
        +$<%= net.round(2) %>
      <% else %>
        -$<%= net.abs.round(2) %>
      <% end %>
    </div>

    <div class="text-sm mt-1">
      <%= net >= 0 ? "People owe you" : "You owe people" %>
    </div>
  </div>

  <!-- DETAIL BALANCES -->
  <h2 class="text-lg font-bold mb-3">
    Details
  </h2>

  <div class="space-y-3">

    <% @balances.each do |user_id, amount| %>
      <% next if user_id == @current_user.id %>
      <% user = User.find(user_id) %>

      <div class="p-3 border rounded-xl flex justify-between items-center">

        <div>
          <div class="font-medium"><%= user.name %></div>

          <div class="text-sm text-gray-500">
            <% if amount > 0 %>
              owes you
            <% elsif amount < 0 %>
              you owe
            <% else %>
              settled
            <% end %>
          </div>
        </div>

        <div class="font-bold
          <%= amount > 0 ? 'text-green-600' : 'text-red-600' %>">

          <% if amount > 0 %>
            +$<%= amount.round(2) %>
          <% elsif amount < 0 %>
            -$<%= amount.abs.round(2) %>
          <% else %>
            $0
          <% end %>
        </div>

      </div>
    <% end %>

  </div>

  <!-- ACTIONS -->
  <div class="mt-6 flex gap-3">
    <%= link_to "➕ Add Expense",
        new_expense_path,
        class: "flex-1 text-center bg-black text-white py-2 rounded-xl" %>

    <%= link_to "📜 History",
        expenses_path,
        class: "flex-1 text-center border py-2 rounded-xl" %>
  </div>

  <h2 class="text-xl font-bold mt-8 mb-2">
  Settle debts
</h2>

<div class="space-y-2">
  <% @settlements.each do |s| %>
    <div class="flex justify-between items-center border p-3 rounded-xl">

      <div>
        <div class="font-medium">
          <%= User.find(s[:from]).name %>
          → 
          <%= User.find(s[:to]).name %>
        </div>

        <div class="text-sm text-gray-500">
          $<%= s[:amount].round(2) %>
        </div>
      </div>

      <%= button_to "Mark as paid",
          settlements_path,
          method: :post,
          params: {
            from_user_id: s[:from],
            to_user_id: s[:to],
            amount: s[:amount]
          },
          class: "bg-black text-white px-3 py-1 rounded-lg" %>
    </div>
  <% end %>
</div>

</div>