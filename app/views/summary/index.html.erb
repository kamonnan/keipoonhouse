<div class="
  max-w-lg
  mx-auto

  min-h-screen

  px-5
  py-6
  pb-24

  sm:px-0
  md:px-4
">

  <%= render "shared/mobile_header",
      back_path: root_path %>

  <!-- HEADER -->

  <h1 class="
    text-4xl
    font-bold
    mb-8
    leading-tight

    sm:text-5xl
    md:text-4xl
  ">
    Hi <%= @current_user.name %> 👋
  </h1>

  <!-- NET BALANCE -->

  <div class="
    rounded-[2rem]
    p-6
    text-white
    mb-8

    sm:p-8
    md:p-7

    <%= @net_balance >= 0 ?
        'bg-green-500' :
        'bg-red-500' %>
  ">

    <div class="
      text-lg
      mb-3
      font-medium

      sm:text-xl
      md:text-lg
    ">
      Balance
    </div>

    <div class="
      text-5xl
      font-bold
      break-words
      mb-4
      leading-none

      sm:text-6xl
      md:text-5xl
    ">
      $<%= @net_balance.abs.round(2) %>
    </div>

    <div class="
      text-lg
      leading-relaxed

      sm:text-xl
      md:text-lg
    ">

      <% if @net_balance > 0 %>

        people owe you

      <% elsif @net_balance < 0 %>

        you owe people

      <% else %>

        everyone is clear 🎉

      <% end %>

    </div>

  </div>

  <!-- ACTIONS -->

  <div class="
    grid
    grid-cols-2
    gap-4
    mb-10
  ">

    <%= link_to new_expense_path,
        class: "
          bg-black
          text-white

          py-4
          px-4

          rounded-3xl

          text-base
          font-semibold

          text-center

          sm:py-5
          sm:text-lg

          md:py-4
          md:text-base

          active:scale-[0.98]
          transition-all
          duration-150
        " do %>

      ➕ Add Bills

    <% end %>

    <%= link_to expenses_path,
        class: "
          border-1
          border-black

          md:py-4
          md:px-4

          rounded-3xl

          md:text-base
          md:font-semibold

          text-center

          sm:py-5
          sm:text-lg

          md:py-4
          md:text-base

          active:scale-[0.98]
          transition-all
          duration-150
        " do %>

      📜 View Bills

    <% end %>

  </div>

  <!-- DETAILS -->

  <h2 class="
    text-2xl
    font-bold
    mb-5

    sm:text-3xl
    md:text-2xl
  ">
    สรุปรายการ
  </h2>

  <% if @debts.empty? %>

    <div class="
      border
      rounded-3xl
      p-6

      bg-white

      text-center
      text-base
      text-gray-500

      sm:p-8
      sm:text-lg

      md:p-6
      md:text-base
    ">

      No debts! 🎉

    </div>

  <% else %>

    <div class="space-y-5">

      <% @debts.each do |debt| %>

        <% is_current_user_creditor =
            debt[:creditor].id ==
            @current_user.id %>

        <div class="
          border
          rounded-[2rem]
          p-5
          bg-white

          sm:p-6
          md:p-5
        ">

          <div class="
            flex
            justify-between
            gap-4
          ">

            <!-- LEFT -->

            <div class="flex-1 min-w-0">

              <!-- NAME -->

              <div class="
                font-bold
                text-2xl
                break-words

                sm:text-3xl
                md:text-2xl
              ">

                <% if is_current_user_creditor %>

                  <%= debt[:debtor].name %>

                <% else %>

                  <%= debt[:creditor].name %>

                <% end %>

              </div>

              <!-- STATUS -->

              <div class="
                text-gray-500
                text-sm
                mt-2

                sm:text-base
                md:text-sm
              ">

                <% if is_current_user_creditor %>

                  owes you

                <% else %>

                  you owe

                <% end %>

              </div>

              <!-- AMOUNT -->

              <div class="
                text-4xl
                font-bold
                mt-5
                break-words

                sm:text-5xl
                md:text-4xl

                <%= is_current_user_creditor ?
                    'text-green-600' :
                    'text-red-600' %>
              ">

                $<%= debt[:amount].round(2) %>

              </div>

            </div>

            <!-- BUTTON -->

            <% if is_current_user_creditor %>

              <%= button_to "Mark paid",
                  settlements_path(
                    user_id: debt[:debtor].id,
                    paid_to_id: debt[:creditor].id
                  ),
                  method: :post,
                  class: "
                    shrink-0

                    bg-black
                    text-white

                    px-4
                    py-2

                    h-fit

                    rounded-2xl

                    text-sm
                    font-medium

                    sm:px-5
                    sm:py-3
                    sm:text-base

                    md:px-4
                    md:py-2
                    md:text-sm

                    active:scale-[0.98]
                    transition-all
                    duration-150
                  " %>

            <% end %>

          </div>

        </div>

      <% end %>

    </div>

  <% end %>

</div>