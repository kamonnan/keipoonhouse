<div class="mb-6">

  <div class="flex items-center gap-4">

    <% if local_assigns[:back_path] %>

      <%= link_to back_path,
          class: "text-3xl font-bold" do %>

        ←

      <% end %>

    <% end %>

    <% if local_assigns[:title] %>

      <div class="text-xl font-bold">
        <%= title %>
      </div>

    <% end %>

  </div>

</div>