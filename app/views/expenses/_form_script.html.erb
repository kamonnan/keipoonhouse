<script>

function initExpenseForm() {

  const addButton =
    document.getElementById("add-item")

  const itemsContainer =
    document.getElementById("items")

  if (!addButton || !itemsContainer) return

  const usersHtmlTemplate = `
  <% @users.each do |user| %>

    <label class="block cursor-pointer">

      <input
        type="checkbox"
        name="expense[expense_items_attributes][INDEX][participant_ids][]"
        value="<%= user.id %>"
        class="hidden peer">

      <div class="
        border
        rounded-xl
        p-3
        text-center
        text-sm
        font-medium
        transition-all
        duration-150

        peer-checked:bg-black
        peer-checked:text-white
      ">

        <%= user.name %>

      </div>

    </label>

  <% end %>
`

  // ADD ITEM
  addButton.onclick = (e) => {

    e.preventDefault()

    const index =
      document.querySelectorAll(".item-row").length

    const usersHtml =
      usersHtmlTemplate.replaceAll("INDEX", index)

    const row = `
      <div class="border rounded-2xl p-3 mb-3 item-row bg-white">

        <div class="flex justify-between items-center mb-3">

          <div class="text-sm font-medium text-gray-500">
            Item ${index + 1}
          </div>

          <button
            type="button"
            class="remove-item text-red-500 text-sm">

            Remove

          </button>

        </div>

        <div class="flex gap-2 mb-3">

          <input
            type="text"
            name="expense[expense_items_attributes][${index}][title]"
            placeholder="Item"
            class="flex-1 border rounded-xl p-3">

          <input
            type="number"
            step="0.01"
            name="expense[expense_items_attributes][${index}][amount]"
            placeholder="$"
            class="w-24 border rounded-xl p-3 item-amount">

        </div>

        <div class="grid grid-cols-2 gap-2">

          ${usersHtml}

        </div>

      </div>
    `

    itemsContainer.insertAdjacentHTML(
      "beforeend",
      row
    )

    updateTotal()
  }

  // REMOVE ITEM
  itemsContainer.onclick = (e) => {

    if (
      e.target.classList.contains("remove-item")
    ) {

      e.preventDefault()

      const row =
        e.target.closest(".item-row")

      if (row) {
        row.remove()
      }

      updateTotal()
    }
  }

  // LIVE TOTAL
  itemsContainer.oninput = (e) => {

    if (
      e.target.classList.contains("item-amount")
    ) {

      updateTotal()

    }
  }

  function updateTotal() {

    let total = 0

    document
      .querySelectorAll(".item-amount")
      .forEach(input => {

        total += parseFloat(input.value) || 0

      })

    const totalElement =
      document.getElementById("total-amount")

    if (totalElement) {

      totalElement.innerText =
        `$${total.toFixed(2)}`

    }
  }

  // IMPORTANT
  // calculate immediately on page load

  updateTotal()
}

// TURBO FIX
document.addEventListener(
  "turbo:load",
  initExpenseForm
)

</script>