<div class="max-w-md mx-auto px-4 py-4">

    <%= render "shared/mobile_header",
    back_path: summary_path %>

  <h1 class="text-3xl font-bold mb-6">
    Bill History
  </h1>

    <div id="expenses">
    <% @expenses.each do |expense| %>
        <div class="border rounded-xl p-4 mb-4">

        <div class="text-xl font-bold">
            <%= expense.title %> - $<%= expense.amount %>
        </div>

        <div class="text-sm text-gray-600 mt-1">
            Paid by: <%= expense.paid_by.name %>
        </div>

        <div class="text-sm text-gray-600">
            Created by: <%= expense.paid_by.name %>
        </div>

        <div class="mt-3">

        <div class="text-sm text-gray-500 mb-2">
            Items
        </div>

        <% expense.expense_items.each do |item| %>

            <div class="border rounded-xl p-3 mb-2">

            <div class="flex justify-between items-center mb-2">

                <div class="font-medium">
                <%= item.title %>
                </div>

                <div class="font-bold">
                $<%= item.amount %>
                </div>

            </div>

            <div class="flex flex-wrap gap-2">

                <% item.expense_item_participants.each do |participant| %>

                <span class="inline-block bg-gray-200 px-2 py-1 rounded text-sm">

                    <%= participant.user.name %>

                </span>

                <% end %>

            </div>

            </div>

        <% end %>

        </div>

        <div class="flex gap-4 mt-4 justify-end">

        <%= link_to "Edit",
            edit_expense_path(expense),
            class: "text-blue-500 bg-black text-white px-3 py-1 rounded-xl w-20 text-center" %>

        <%= button_to "Delete",
            expense_path(expense),
            method: :delete,
            class: " bg-white text-black border border-black px-3 py-1 rounded-xl items-center w-20 text-center" %>

        </div>

        </div>
    <% end %>
    </div>
</div>