<div class="max-w-md mx-auto px-4 py-4 pb-24">

  <%= render "shared/mobile_header",
    back_path: summary_path %>

  <h1 class="text-3xl font-bold mb-6">

    <%= local_assigns[:heading] || "Expense" %>

  </h1>

  <%= form_with model: @expense do |f| %>

    <!-- TITLE -->
    <div class="mb-4">

      <label class="text-sm text-gray-500">
        Title
      </label>

      <%= f.text_field :title,
          class: "w-full border rounded-xl p-3 mt-1",
          placeholder: "e.g. Costco" %>

    </div>

    <!-- ITEMS -->
    <div class="mb-6">

      <div class="flex justify-between items-center mb-3">

        <div class="text-sm text-gray-500">
          Items
        </div>

        <button
          type="button"
          id="add-item"
          class="text-sm text-blue-500">

          + Add item

        </button>

      </div>

      <div id="items">

        <% if @expense.expense_items.any? %>

          <% @expense.expense_items.each_with_index do |item, index| %>

            <div class="border rounded-2xl p-3 mb-3 item-row bg-white">

              <div class="flex justify-between items-center mb-3">

                <div class="text-sm font-medium text-gray-500">
                  Item <%= index + 1 %>
                </div>

                <button
                  type="button"
                  class="remove-item text-red-500 text-sm">

                  Remove

                </button>

              </div>

              <div class="flex gap-2 mb-3">

                <input
                  type="text"
                  name="expense[expense_items_attributes][<%= index %>][title]"
                  value="<%= item.title %>"
                  placeholder="Item"
                  class="flex-1 border rounded-xl p-3">

                <input
                  type="number"
                  step="0.01"
                  name="expense[expense_items_attributes][<%= index %>][amount]"
                  value="<%= item.amount %>"
                  placeholder="$"
                  class="w-24 border rounded-xl p-3 item-amount">

              </div>

              <div class="grid grid-cols-2 gap-2">

                <% @users.each do |user| %>

                  <% checked =
                    item.expense_item_participants
                      .pluck(:user_id)
                      .include?(user.id) %>

                  <label class="flex items-center gap-2 border rounded-xl p-2 text-sm">

                    <input
                      type="checkbox"
                      name="expense[expense_items_attributes][<%= index %>][participant_ids][]"
                      value="<%= user.id %>"
                      <%= "checked" if checked %>
                      class="w-4 h-4">

                    <span><%= user.name %></span>

                  </label>

                <% end %>

              </div>

            </div>

          <% end %>

        <% else %>

          <div class="border rounded-2xl p-3 mb-3 item-row bg-white">

            <div class="flex justify-between items-center mb-3">

              <div class="text-sm font-medium text-gray-500">
                Item 1
              </div>

              <button
                type="button"
                class="remove-item text-red-500 text-sm">

                Remove

              </button>

            </div>

            <div class="flex gap-2 mb-3">

              <input
                type="text"
                name="expense[expense_items_attributes][0][title]"
                placeholder="Item"
                class="flex-1 border rounded-xl p-3">

              <input
                type="number"
                step="0.01"
                name="expense[expense_items_attributes][0][amount]"
                placeholder="$"
                class="w-24 border rounded-xl p-3 item-amount">

            </div>

          </div>

        <% end %>

      </div>

      <!-- TOTAL -->
      <div class="flex justify-between items-center mt-4 px-1">

        <div class="text-gray-500">
          Total
        </div>

        <div
          id="total-amount"
          class="text-xl font-bold">

          $0.00

        </div>

      </div>

    </div>

    <%= f.submit(
        local_assigns[:button_text] || "Save",
        class: "w-full bg-black text-white py-3 rounded-xl"
      ) %>

  <% end %>

</div>

<%= render "expenses/form_script" %>