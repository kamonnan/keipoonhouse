<div class="max-w-md mx-auto px-4 py-4">

  <%= render "shared/mobile_header", title: "Add Expense" %>

  <h1 class="text-3xl font-bold mb-6">
    ➕ Add Expense
  </h1>

  <%= form_with model: @expense do |f| %>

    <!-- TITLE -->
    <div class="mb-4">
      <label class="text-sm text-gray-500">Title</label>
      <%= f.text_field :title,
          class: "w-full border rounded-xl p-3 mt-1",
          placeholder: "e.g. Costco, Dinner, Gas" %>
    </div>

    <!-- AMOUNT -->
    <div class="mb-6">

      <div class="flex justify-between items-center mb-3">
        <div class="text-sm text-gray-500">
          Items
        </div>

        <button
          type="button"
          id="add-item"
          class="text-sm text-blue-500">
          + Add item
        </button>
      </div>

      <div id="items">

        <%= f.fields_for :expense_items do |item_form| %>

          <div class="flex gap-2 mb-2 item-row">

            <%= item_form.text_field :title,
                placeholder: "Item",
                class: "flex-1 border rounded-xl p-3" %>

            <%= item_form.number_field :amount,
                step: 0.01,
                placeholder: "$",
                class: "w-24 border rounded-xl p-3 item-amount" %>

          </div>

        <% end %>

      </div>

    </div>

    <!-- SPLIT -->
    <div class="mb-6">
      <div class="text-sm text-gray-500 mb-2">
        Split with
      </div>

      <div class="grid grid-cols-2 gap-2">
        <% @users.each do |user| %>

          <label class="flex items-center gap-2 border rounded-xl p-2">

            <%= check_box_tag "expense[participant_ids][]",
                user.id,
                false,
                class: "w-4 h-4" %>

            <span><%= user.name %></span>

          </label>

        <% end %>
      </div>
      <button type="button"
          onclick="
            document.querySelectorAll('input[type=checkbox]').forEach(cb => cb.checked = true)
          "
          class="text-sm text-blue-500 mb-2">
          Select all
        </button>
    </div>

    

    <!-- SUBMIT -->
    <%= f.submit "Create Expense",
        class: "w-full bg-black text-white py-3 rounded-xl" %>

  <% end %>

</div>

<script>
document.addEventListener("DOMContentLoaded", () => {

  const addButton = document.getElementById("add-item")
  const itemsContainer = document.getElementById("items")

  addButton.addEventListener("click", () => {

    const index = document.querySelectorAll(".item-row").length

    const row = `
      <div class="flex gap-2 mb-2 item-row">

        <input
          type="text"
          name="expense[expense_items_attributes][${index}][title]"
          placeholder="Item"
          class="flex-1 border rounded-xl p-3">

        <input
          type="number"
          step="0.01"
          name="expense[expense_items_attributes][${index}][amount]"
          placeholder="$"
          class="w-24 border rounded-xl p-3 item-amount">

      </div>
    `

    itemsContainer.insertAdjacentHTML("beforeend", row)
  })

})
</script>