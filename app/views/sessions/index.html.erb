<div class="max-w-md mx-auto px-4 py-4">
  <h1 class="text-3xl font-bold mb-8">
    Who's using?
  </h1>

  <div class="flex flex-col gap-4 w-64">
    <% @users.each do |user| %>
      <%= button_to user.name,
      sessions_path(user_id: user.id),
      method: :post,
      class: "bg-black text-white py-3 rounded-xl cursor-pointer" %>
    <% end %>
  </div>
</div>