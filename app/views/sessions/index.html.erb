<div class="min-h-screen flex flex-col justify-center max-w-md mx-auto px-6 py-8">

  <h1 class="text-6xl font-bold mb-10 text-center">
    Who's using?
  </h1>

  <div class="flex flex-col gap-4">

    <% @users.each do |user| %>

      <%= button_to user.name,
      sessions_path(user_id: user.id),
      method: :post,
      class: "w-full bg-none border-1 border-black text-black sm:p-10 md:p-6 sm:mb-2 md:mb-0 rounded-2xl md:text-xl sm:text-2xl font-semibold text-center
        active:scale-[0.98] transition-all duration-150 cursor-pointer" %>

    <% end %>

  </div>

</div>